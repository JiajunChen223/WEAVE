{
  "dataset": "cave",
  "scales": [
    2,
    4,
    8
  ],
  "external_methods": [
    "cssnet",
    "psrt",
    "dcinn",
    "le_mamba",
    "ddif",
    "otias",
    "hsc_sampling",
    "emr_diff",
    "bhsrnet",
    "cnmf",
    "hysure",
    "cstf"
  ],
